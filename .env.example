# Optional development configuration. Copy to .env.local when connecting a model.
# The default is a local demo. Never commit a real key.
COMPUTERCAT_RUNTIME=demo
COMPUTERCAT_PROVIDER=
COMPUTERCAT_MODEL=
COMPUTERCAT_API_KEY=
# Optional preferred Brave provider, separate from the model connection.
# Keyless search, browser recovery and page reading work without this key.
# .env.local is loaded by npm run dev. Packaged apps use their launch environment.
COMPUTERCAT_BRAVE_SEARCH_API_KEY=
