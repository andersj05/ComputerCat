{
  "name": "computercat",
  "productName": "Computer Cat",
  "version": "0.1.0",
  "description": "A helpful desktop companion powered by the Pi agent SDK.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "Anders Jensen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andersj05/ComputerCat.git"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/electron-vite/bin/electron-vite.js dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "memory:check": "node scripts/check-memory.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run build && playwright test",
    "verify": "npm run memory:check && npm run lint && npm run typecheck && npm test && npm run build",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "voice:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-whisper-helper.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-whisper-helper.ps1 -Avx2",
    "voice:test-native": "node native/whisper-helper/tests/check.mjs && node native/whisper-helper/tests/lifecycle.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
